# Database connection URL for PostgreSQL
# Thay đổi theo thông số PostgreSQL của bạn hoặc chạy Docker Compose
DATABASE_URL="postgresql://postgres:123456@localhost:5432/rental_db?schema=public"

# Hoặc nếu chạy bằng docker-compose up -d:
# DATABASE_URL="postgresql://postgres:adminpassword@localhost:5432/rental_db?schema=public"
